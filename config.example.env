# ===== English Lesson Video · 配置模板 =====
# 复制为 config.env（与本文件同级），按需填写。**不要**把 config.env 提交到公开仓库。
# 优先级：环境变量 > config.env。也可以把配置放到 ~/.config/english-lesson-video/config.env。

# ---------- 必填：渲染视频时需要 ----------
# ElevenLabs API key（只有合成旁白用得到；不渲染视频可以不填）
ELEVENLABS_API_KEY=

# 默认音色。要求是多语种音色；只用一种语言时填这个就够。
ELEVENLABS_VOICE_ID=

# 按母语单独指定音色（可选）。留空则回落到 ELEVENLABS_VOICE_ID。
ELEVENLABS_VOICE_ZH=
ELEVENLABS_VOICE_JA=
ELEVENLABS_VOICE_KO=
ELEVENLABS_VOICE_PT=
ELEVENLABS_VOICE_ES=
ELEVENLABS_VOICE_DE=
ELEVENLABS_VOICE_FR=

# 模型：eleven_v3（推荐）或 eleven_multilingual_v2
ELEVENLABS_MODEL=eleven_v3

# ---------- 必填：工作目录 ----------
# 你的项目根目录。脚本会在这里建 specs/、work/ 和每个选题的输出目录。
LESSON_HOME=

# 源视频（整段访谈/播客）。单个选题也可以在 SPEC 里用 src= 覆盖。
SOURCE_VIDEO=

# 选题目录（可选，默认 $LESSON_HOME/specs）
SPECS_DIR=

# ---------- 语言 ----------
# 学习者母语：zh | ja | ko | pt | es | de | fr
NATIVE_LANG=zh

# ---------- 品牌（可全部留空） ----------
BRAND_NAME=
BRAND_URL=
BRAND_TAGLINE=
# 方形 logo PNG；留空则不画 logo
LESSON_LOGO=

# ---------- 节奏 ----------
# 整体倍速（旁白 atempo）；1.0 = 原速
OUTPUT_SPEED=1.2
# 英文原句放慢倍数；1.0 = 不放慢
EN_SLOW=0.8

# ---------- 工具链 ----------
# 无头 Chrome（生成 PDF / 截图用）
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# 本地转写的 whisper 档位：tiny | base | small | medium
ASR_MODEL=small
